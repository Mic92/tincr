+package schema
+
+// FirstFactorNetwork is the configuration for network identity based passwordless first factor
+// authentication. The identity of the client address is resolved by an external whois backend
+// speaking the nginx auth_request protocol over a unix socket, for example tinc-auth or a wrapper
+// around tailscale's nginx-auth. The username from the configured response header is looked up in
+// the regular authentication backend and a one factor session is established for that user
+// without a password.
+type FirstFactorNetwork struct {
+	Enable bool   `koanf:"enable" yaml:"enable" toml:"enable" json:"enable" jsonschema:"default=false,title=Enable" jsonschema_description:"Enables network identity based first factor authentication."`
+	Socket string `koanf:"socket" yaml:"socket,omitempty" toml:"socket,omitempty" json:"socket,omitempty" jsonschema:"title=Socket Path" jsonschema_description:"The path to the whois unix socket."`
+	Header string `koanf:"header" yaml:"header,omitempty" toml:"header,omitempty" json:"header,omitempty" jsonschema:"default=Remote-User,title=Identity Header" jsonschema_description:"The whois response header which carries the username."`
+}
