+package validator
+
+import (
+	"fmt"
+
+	"github.com/authelia/authelia/v4/internal/configuration/schema"
+)
+
+// ValidateFirstFactorNetwork validates the network identity first factor configuration.
+func ValidateFirstFactorNetwork(config *schema.Configuration, validator *schema.StructValidator) {
+	if !config.FirstFactorNetwork.Enable {
+		return
+	}
+
+	if config.FirstFactorNetwork.Socket == "" {
+		validator.Push(fmt.Errorf("first_factor_network: option 'socket' is required when this authentication method is enabled"))
+	}
+
+	if config.FirstFactorNetwork.Header == "" {
+		config.FirstFactorNetwork.Header = "Remote-User"
+	}
+}
diff --git a/internal/handlers/handler_firstfactor_network.go b/internal/handlers/handler_firstfactor_network.go
new file mode 100644
index 000000000..ea6b1cb04
--- /dev/null
+++ b/internal/handlers/handler_firstfactor_network.go
@@ -0,0 +1,194 @@
+package handlers
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/textproto"
+	"time"
+
+	"github.com/authelia/authelia/v4/internal/authentication"
+	"github.com/authelia/authelia/v4/internal/regulation"
+	"github.com/authelia/authelia/v4/internal/session"
+
+	"github.com/authelia/authelia/v4/internal/middlewares"
+)
+
+// networkWhois asks the whois backend which user owns addr. The backend speaks the nginx
+// auth_request protocol: a request with a Remote-Addr header is answered with 204 and the
+// identity header on a match, or 401 when the address is not part of the network.
+func networkWhois(socket, header string, addr net.IP, timeout time.Duration) (username string, err error) {
+	conn, err := net.DialTimeout("unix", socket, timeout)
+	if err != nil {
+		return "", fmt.Errorf("failed to connect to whois socket: %w", err)
+	}
+
+	defer conn.Close()
+
+	if err = conn.SetDeadline(time.Now().Add(timeout)); err != nil {
+		return "", fmt.Errorf("failed to set whois socket deadline: %w", err)
+	}
+
+	if _, err = fmt.Fprintf(conn, "GET / HTTP/1.1\r\nHost: whois\r\nRemote-Addr: %s\r\nConnection: close\r\n\r\n", addr); err != nil {
+		return "", fmt.Errorf("failed to write whois request: %w", err)
+	}
+
+	reader := bufio.NewReader(conn)
+
+	resp, err := http.ReadResponse(reader, nil)
+	if err != nil {
+		return "", fmt.Errorf("failed to read whois response: %w", err)
+	}
+
+	defer resp.Body.Close()
+
+	switch resp.StatusCode {
+	case http.StatusNoContent:
+		if username = resp.Header.Get(textproto.CanonicalMIMEHeaderKey(header)); username == "" {
+			return "", fmt.Errorf("whois backend answered %d without a %s header", resp.StatusCode, header)
+		}
+
+		return username, nil
+	case http.StatusUnauthorized:
+		return "", nil
+	default:
+		return "", fmt.Errorf("whois backend answered with unexpected status %d", resp.StatusCode)
+	}
+}
+
+// FirstFactorNetworkPOST is the handler performing passwordless first factor authentication from
+// network identity. The client address is resolved to a username by the whois backend and the
+// username is looked up in the authentication backend.
+func FirstFactorNetworkPOST() middlewares.RequestHandler {
+	return func(ctx *middlewares.AutheliaCtx) {
+		bodyJSON := bodyFirstFactorNetworkRequest{}
+
+		var (
+			details *authentication.UserDetails
+			err     error
+		)
+
+		if err = ctx.ParseBody(&bodyJSON); err != nil {
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			ctx.Logger.WithError(err).Errorf(logFmtErrParseRequestBody, regulation.AuthType1FA)
+
+			return
+		}
+
+		ip := ctx.RemoteIP()
+
+		username, err := networkWhois(ctx.Configuration.FirstFactorNetwork.Socket, ctx.Configuration.FirstFactorNetwork.Header, ip, time.Second*5)
+		if err != nil {
+			ctx.Logger.WithError(err).Error("Error occurred resolving the client address to a network identity")
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		if username == "" {
+			ctx.Logger.Debugf("Client address %s does not resolve to a network identity", ip)
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		if details, err = ctx.Providers.UserProvider.GetDetails(username); err != nil || details == nil {
+			doMarkAuthenticationAttempt(ctx, false, regulation.NewBan(regulation.BanTypeUnknown, "", nil), regulation.AuthType1FA, err)
+
+			ctx.Logger.WithError(err).Errorf("Error occurred getting details for user with network identity '%s' which usually indicates no matching user exists", username)
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		if ban, _, expires, err := ctx.Providers.Regulator.BanCheck(ctx, details.Username); err != nil {
+			if errors.Is(err, regulation.ErrUserIsBanned) {
+				doMarkAuthenticationAttempt(ctx, false, regulation.NewBan(ban, details.Username, expires), regulation.AuthType1FA, nil)
+
+				respondUnauthorized(ctx, messageAuthenticationFailed)
+
+				return
+			}
+
+			ctx.Logger.WithError(err).Errorf(logFmtErrRegulationFail, regulation.AuthType1FA, details.Username)
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		doMarkAuthenticationAttempt(ctx, true, regulation.NewBan(regulation.BanTypeNone, details.Username, nil), regulation.AuthType1FA, nil)
+
+		var provider *session.Session
+
+		if provider, err = ctx.GetSessionProvider(); err != nil {
+			ctx.Logger.WithError(err).Error("Failed to get session provider during 1FA attempt")
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		if err = provider.DestroySession(ctx.RequestCtx); err != nil {
+			ctx.Logger.WithError(err).Trace("Failed to destroy session during 1FA attempt")
+		}
+
+		userSession := provider.NewDefaultUserSession()
+
+		if err = provider.SaveSession(ctx.RequestCtx, userSession); err != nil {
+			ctx.Logger.WithError(err).Errorf(logFmtErrSessionReset, regulation.AuthType1FA, details.Username)
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		if err = provider.RegenerateSession(ctx.RequestCtx); err != nil {
+			ctx.Logger.WithError(err).Errorf(logFmtErrSessionRegenerate, regulation.AuthType1FA, details.Username)
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		keepMeLoggedIn := !provider.Config.DisableRememberMe && bodyJSON.KeepMeLoggedIn != nil && *bodyJSON.KeepMeLoggedIn
+
+		if keepMeLoggedIn {
+			if err = provider.UpdateExpiration(ctx.RequestCtx, provider.Config.RememberMe); err != nil {
+				ctx.Logger.WithError(err).Errorf(logFmtErrSessionSave, "updated expiration", regulation.AuthType1FA, logFmtActionAuthentication, details.Username)
+
+				respondUnauthorized(ctx, messageAuthenticationFailed)
+
+				return
+			}
+		}
+
+		ctx.Logger.Tracef(logFmtTraceProfileDetails, details.Username, details.Groups, details.Emails)
+
+		userSession.SetOneFactorNetwork(ctx.GetClock().Now(), details, keepMeLoggedIn)
+
+		if ctx.Configuration.AuthenticationBackend.RefreshInterval.Update() {
+			userSession.RefreshTTL = ctx.GetClock().Now().Add(ctx.Configuration.AuthenticationBackend.RefreshInterval.Value())
+		}
+
+		if err = provider.SaveSession(ctx.RequestCtx, userSession); err != nil {
+			ctx.Logger.WithError(err).Errorf(logFmtErrSessionSave, "updated profile", regulation.AuthType1FA, logFmtActionAuthentication, details.Username)
+
+			respondUnauthorized(ctx, messageAuthenticationFailed)
+
+			return
+		}
+
+		if len(bodyJSON.Flow) > 0 {
+			handleFlowResponse(ctx, &userSession, bodyJSON.FlowID, bodyJSON.Flow, bodyJSON.SubFlow, bodyJSON.UserCode)
+		} else {
+			Handle1FAResponse(ctx, bodyJSON.TargetURL, bodyJSON.RequestMethod, userSession.Username, userSession.Groups)
+		}
+	}
+}
diff --git a/internal/handlers/handler_firstfactor_network_test.go b/internal/handlers/handler_firstfactor_network_test.go
new file mode 100644
index 000000000..0e5f2df5c
--- /dev/null
+++ b/internal/handlers/handler_firstfactor_network_test.go
@@ -0,0 +1,105 @@
+package handlers
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func serveWhois(t *testing.T, response string) (socket string) {
+	t.Helper()
+
+	dir := t.TempDir()
+	socket = filepath.Join(dir, "whois.sock")
+
+	listener, err := net.Listen("unix", socket)
+	require.NoError(t, err)
+
+	t.Cleanup(func() {
+		listener.Close()
+	})
+
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+
+			buf := make([]byte, 4096)
+
+			if _, err = conn.Read(buf); err == nil {
+				_, _ = fmt.Fprint(conn, response)
+			}
+
+			conn.Close()
+		}
+	}()
+
+	return socket
+}
+
+func TestNetworkWhois(t *testing.T) {
+	testCases := []struct {
+		name     string
+		response string
+		expected string
+		err      string
+	}{
+		{
+			"ShouldResolveNode",
+			"HTTP/1.1 204 No Content\r\nRemote-User: alice\r\nTinc-Node: alice\r\nConnection: close\r\n\r\n",
+			"alice",
+			"",
+		},
+		{
+			"ShouldTreatUnauthorizedAsNoIdentity",
+			"HTTP/1.1 401 Unauthorized\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+			"",
+			"",
+		},
+		{
+			"ShouldErrorOnMissingHeader",
+			"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n",
+			"",
+			"whois backend answered 204 without a Remote-User header",
+		},
+		{
+			"ShouldErrorOnBackendFailure",
+			"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+			"",
+			"whois backend answered with unexpected status 503",
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			socket := serveWhois(t, tc.response)
+
+			username, err := networkWhois(socket, "Remote-User", net.ParseIP("10.20.0.1"), time.Second)
+
+			if tc.err == "" {
+				assert.NoError(t, err)
+				assert.Equal(t, tc.expected, username)
+			} else {
+				assert.EqualError(t, err, tc.err)
+			}
+		})
+	}
+}
+
+func TestNetworkWhoisDeadSocket(t *testing.T) {
+	dir := t.TempDir()
+	socket := filepath.Join(dir, "nowhere.sock")
+
+	_, err := networkWhois(socket, "Remote-User", net.ParseIP("10.20.0.1"), time.Second)
+	require.Error(t, err)
+	assert.ErrorContains(t, err, "failed to connect to whois socket")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+}
